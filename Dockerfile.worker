ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-trixie-slim
FROM ${NODE_IMAGE} AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts=false
RUN pnpm --filter @theckards/domain build \
 && pnpm --filter @theckards/database build \
 && pnpm --filter @theckards/worker build
RUN pnpm --filter @theckards/worker --prod deploy /out --legacy

FROM ${NODE_IMAGE}
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --from=build /out ./
USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]
