# Alpine: Debian 12/13 slim images carry HIGH glibc/zlib CVEs without vendor fixes (2026-11).
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine3.24
FROM ${NODE_IMAGE} AS build
RUN apk upgrade --no-cache
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts=false
RUN pnpm --filter @theckards/domain build \
 && pnpm --filter @theckards/database build \
 && pnpm --filter @theckards/worker build
RUN pnpm --filter @theckards/worker --prod deploy /out --legacy

FROM ${NODE_IMAGE}
# Pick up OS security fixes newer than the base image (e.g. zlib 1.4).
RUN apk upgrade --no-cache
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --from=build /out ./
USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]
